# Fleet SSL Expiry Guard Configuration

# Target domains (comma-separated)
DOMAINS=google.com,github.com,cloudflare.com

# Expiration Thresholds in days
ALERT_THRESHOLD_DAYS=15
WARN_THRESHOLD_DAYS=30

# Network Settings
DEFAULT_PORT=443
CHECK_TIMEOUT=5.0

# Export Settings (table, json, csv)
EXPORT_FORMAT=json
EXPORT_PATH=ssl_report.json
